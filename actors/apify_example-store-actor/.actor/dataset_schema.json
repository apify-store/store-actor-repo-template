{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {},
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": ["id", "name", "height", "weight", "types", "abilities"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "id": {
                        "label": "ID",
                        "format": "number"
                    },
                    "name": {
                        "label": "Name",
                        "format": "text"
                    },
                    "height": {
                        "label": "Height",
                        "format": "number"
                    },
                    "weight": {
                        "label": "Weight",
                        "format": "number"
                    },
                    "types": {
                        "label": "Types",
                        "format": "array"
                    },
                    "abilities": {
                        "label": "Abilities",
                        "format": "array"
                    }
                }
            }
        }
    }
}
