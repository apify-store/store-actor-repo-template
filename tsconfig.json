{
    "extends": "@apify/tsconfig",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "esnext",
        "outDir": "dist",
        "rootDir": ".",
        "incremental": false,
        "noUnusedLocals": false,
        "skipLibCheck": true,
        "lib": ["ESNext"]
    },
    "include": ["./src/**/*", "./test/**/*", "rolldown.config.ts"]
}
