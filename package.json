{
    "name": "example-store-actor",
    "version": "0.0.1",
    "description": "This is a boilerplate of an Apify Actor.",
    "license": "ISC",
    "author": "It's not you it's me",
    "type": "module",
    "dependencies": {
        "@crawlee/impit-client": "^3.17.0",
        "apify": "^3.7.2",
        "crawlee": "^3.17.0"
    },
    "devDependencies": {
        "@apify/oxlint-config": "^0.2.10",
        "@apify/tsconfig": "^0.2.0",
        "@vitest/coverage-v8": "^4.1.8",
        "apify-test-tools": "^0.8.0",
        "husky": "^9.1.7",
        "knip": "^6.17.1",
        "lefthook": "^2.1.9",
        "lint-staged": "^17.0.7",
        "oxfmt": "^0.55.0",
        "oxlint": "^1.70.0",
        "oxlint-tsgolint": "^0.23.0",
        "rolldown": "^1.1.3",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "vitest": "^4.1.8"
    },
    "scripts": {
        "start": "npm run start:dev",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "rolldown -c",
        "build-check": "tsc --noEmit",
        "lint": "oxlint --type-aware",
        "lint:fix": "oxlint --type-aware --fix",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "test": "vitest run --coverage",
        "prepare": "lefthook install || true",
        "reset-hooks": "lefthook install --reset-hooks-path",
        "check-unused": "knip --include exports,types"
    },
    "lint-staged": {
        "*.ts": "oxlint --type-aware",
        "*.tsx": "oxlint --type-aware",
        "*.{ts,tsx,js,json,md}": "oxfmt --write"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
