{
    "name": "example-store-actor",
    "version": "0.0.1",
    "description": "This is a boilerplate of an Apify Actor.",
    "license": "ISC",
    "author": "It's not you it's me",
    "type": "module",
    "scripts": {
        "start": "npm run start:dev",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "lint": "oxlint --type-aware",
        "lint:fix": "oxlint --type-aware --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run --coverage",
        "prepare": "husky .husky || true",
        "check-unused": "knip --include exports,types"
    },
    "dependencies": {
        "apify": "^3.7.2"
    },
    "devDependencies": {
        "@apify/oxlint-config": "^0.2.10",
        "@apify/tsconfig": "^0.2.0",
        "@vitest/coverage-v8": "^4.1.8",
        "apify-test-tools": "^0.8.0",
        "husky": "^9.1.7",
        "knip": "^6.17.1",
        "lint-staged": "^17.0.7",
        "oxlint": "^1.70.0",
        "oxlint-tsgolint": "^0.23.0",
        "prettier": "^3.8.4",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "vitest": "^4.1.8"
    },
    "lint-staged": {
        "*.{ts,tsx}": "oxlint"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
